<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>حاسبة أقساط القروض</title>
<style>
:root{--gold:#e6c673;--gold2:#a98b4a;--line:#5a4a26;--text:#f3efe6;--muted:#c4bba7;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:#000;color:var(--text);font-family:system-ui,"Segoe UI",Tahoma,Arial,sans-serif;line-height:1.6}
.app{max-width:480px;margin:14px auto;padding:20px 16px;border:1.5px solid var(--gold2);border-radius:26px;background:linear-gradient(160deg,#1a1a1a,#050505)}
h1{color:var(--gold);text-align:center;font-size:1.45rem;margin:4px 0 14px;padding-bottom:14px;border-bottom:1px solid var(--gold2)}
.tabs{display:flex;gap:10px;margin-bottom:12px}
.tab{flex:1;padding:12px;border-radius:12px;border:1px solid var(--line);background:#111;color:var(--muted);font:inherit;cursor:pointer}
.tab.on{border-color:var(--gold);color:var(--gold);background:linear-gradient(#2a2410,#0d0d0d)}
input,select{width:100%;padding:12px 16px;margin-bottom:8px;border-radius:14px;border:1px solid #3a3a3a;background:#0b0b0b;color:var(--text);font:inherit;font-size:1.05rem}
input::placeholder{color:#8a826f;font-size:.92rem}
select:invalid{color:#8a826f;font-size:.92rem}
.btn{width:100%;padding:14px;border-radius:14px;font:inherit;font-weight:700;cursor:pointer}
.go{border:1px solid var(--gold);background:linear-gradient(#e9cb7a,#a97f2d);color:#1a1405;font-size:1.05rem;margin:4px 0 14px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.c{border:1px solid #333;border-radius:14px;padding:12px;text-align:center;background:#0b0b0b}
.c small{display:block;color:var(--muted);font-size:.82rem}
.c b{color:var(--gold);font-size:1.25rem;font-weight:500;font-variant-numeric:tabular-nums}
.big{border:1px solid var(--gold2);border-radius:14px;padding:14px;text-align:center;background:#120e04}
.big small{color:var(--muted)}
.big b{display:block;font-size:2rem;font-weight:500;font-variant-numeric:tabular-nums}
.big em{font-style:normal;color:var(--gold);font-size:1rem}
.err{color:#f2a0a0;text-align:center;min-height:2.2em;font-size:.9rem;margin-bottom:6px}
.acts{display:flex;gap:8px;margin:10px 0}
.acts .btn{padding:12px 6px;font-size:.92rem;font-weight:500;background:#0b0b0b}
.new{border:1px solid #b4363a;color:#f4a3a5}
.sv{border:1px solid var(--gold2);color:var(--gold)}
.wrap{max-height:62vh;overflow:auto;border:1px solid #333;border-radius:12px;margin-bottom:12px}
table{width:100%;border-collapse:collapse;font-size:.85rem;font-variant-numeric:tabular-nums}
th,td{padding:8px 6px;text-align:center;border-bottom:1px solid #222;white-space:nowrap}
th{position:sticky;top:0;background:#1c1608;color:var(--gold);font-weight:600}
.foot{text-align:center;font-size:.8rem;color:var(--muted);margin-top:8px}
</style>
</head>
<body>
<div class="app">
<h1>حاسبة أقساط القروض</h1>
<div id="main">
  <div class="tabs">
    <button class="tab on" id="tm" type="button">فائدة متناقصة</button>
    <button class="tab" id="tf" type="button">فائدة ثابتة</button>
  </div>
  <select id="type" aria-label="نوع القرض">
    <option value="قرض شخصي" selected>قرض شخصي</option>
    <option value="قرض سيارة">قرض سيارة</option>
    <option value="قرض عقاري">قرض عقاري</option>
  </select>
  <input id="amt" type="text" inputmode="decimal" autocomplete="off" placeholder="مبلغ القرض" aria-label="مبلغ القرض">
  <input id="rate" type="number" inputmode="decimal" step="0.01" min="0" placeholder="سعر الفائدة % سنوياً" aria-label="سعر الفائدة">
  <select id="months" required aria-label="المدة"><option value="" selected disabled>المدة (بالشهور)</option></select>
  <input id="fee" type="number" inputmode="decimal" step="0.01" min="0" placeholder="المصاريف الإدارية % من القرض (اختياري)" aria-label="المصاريف الإدارية">
  <button class="btn go" id="go" type="button">حساب القرض</button>

  <div class="grid">
    <div class="c"><small>إجمالي الفوائد</small><b id="r1">—</b></div>
    <div class="c"><small>إجمالي المسدد</small><b id="r2">—</b></div>
    <div class="c"><small>المصاريف الإدارية</small><b id="r3">—</b></div>
    <div class="c"><small>عدد الأقساط</small><b id="r4">—</b></div>
  </div>
  <div class="big"><small id="r0">القسط الشهري</small><b id="r5">—</b><em id="r6">المعدل السنوي الفعلي: —</em></div>
  <div class="err" id="err"></div>
  <div class="acts">
    <button class="btn new" id="nw" type="button">إدخال جديد</button>
    <button class="btn sv" id="sc" type="button">جدول السداد</button>
  </div>
</div>

<div id="pg" style="display:none">
  <h2 style="color:var(--gold);text-align:center;font-size:1.15rem;margin:0 0 12px">جدول السداد</h2>
  <div class="wrap"><table><thead><tr><th>القسط</th><th>المبلغ</th><th>الفائدة</th><th>الأصل</th><th>الرصيد</th></tr></thead>
